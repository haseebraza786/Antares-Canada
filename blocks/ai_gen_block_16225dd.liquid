{% doc %}
  @prompt
    a text box box with changeable tex color

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-box-{{ ai_gen_id }} {
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: {{ block.settings.text_alignment }};
    max-width: 100%;
  }

  .ai-text-box__content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.5;
    margin: 0;
  }

  .ai-text-box__content-{{ ai_gen_id }} h1,
  .ai-text-box__content-{{ ai_gen_id }} h2,
  .ai-text-box__content-{{ ai_gen_id }} h3,
  .ai-text-box__content-{{ ai_gen_id }} h4,
  .ai-text-box__content-{{ ai_gen_id }} h5,
  .ai-text-box__content-{{ ai_gen_id }} h6 {
    color: {{ block.settings.heading_color }};
    margin-top: 0;
    margin-bottom: 0.5em;
  }

  .ai-text-box__content-{{ ai_gen_id }} p {
    margin-top: 0;
    margin-bottom: 1em;
  }

  .ai-text-box__content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-text-box__content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
  }

  .ai-text-box__content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }
{% endstyle %}

<div class="ai-text-box-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.content != blank %}
    <div class="ai-text-box__content-{{ ai_gen_id }}">
      {{ block.settings.content }}
    </div>
  {% else %}
    <div class="ai-text-box__content-{{ ai_gen_id }}">
      <p>Add your text content here. You can customize the colors, styling, and alignment in the block settings.</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Text box",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Text content",
      "default": "<p>Add your text content here. You can customize the colors, styling, and alignment in the block settings.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#000f9f"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e6e6e6"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Text box"
    }
  ],
  "tag": null
}
{% endschema %}