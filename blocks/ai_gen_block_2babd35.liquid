{% doc %}
  @prompt
    i want a text box  with changable font, font weight , style , size ,color all for mobile and desktop

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-box-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.padding_desktop }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-text-box-content-{{ ai_gen_id }} {
    font-family: {{ block.settings.font_family_desktop.family }}, {{ block.settings.font_family_desktop.fallback_families }};
    font-weight: {{ block.settings.font_weight_desktop }};
    font-style: {{ block.settings.font_style_desktop }};
    font-size: {{ block.settings.font_size_desktop }}px;
    color: {{ block.settings.text_color_desktop }};
    line-height: 1.4;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-text-box-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_mobile }}px;
    }

    .ai-text-box-content-{{ ai_gen_id }} {
      font-family: {{ block.settings.font_family_mobile.family }}, {{ block.settings.font_family_mobile.fallback_families }};
      font-weight: {{ block.settings.font_weight_mobile }};
      font-style: {{ block.settings.font_style_mobile }};
      font-size: {{ block.settings.font_size_mobile }}px;
      color: {{ block.settings.text_color_mobile }};
    }
  }
{% endstyle %}

<div class="ai-text-box-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.text_content != blank %}
    <div class="ai-text-box-content-{{ ai_gen_id }}">
      {{ block.settings.text_content }}
    </div>
  {% else %}
    <div class="ai-text-box-content-{{ ai_gen_id }}" style="color: #999; font-style: italic;">
      Add your text content here
    </div>
  {% endif %}
</div>

{% schema %}
{
