
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}


{% style %}
  .ai-product-tabs-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
  }

  .ai-product-tabs__nav-{{ ai_gen_id }} {
    display: flex;
    border-bottom: 1px solid {{ block.settings.border_color }};
    margin-bottom: {{ block.settings.content_spacing }}px;

  }

  .ai-product-tabs__tab-{{ ai_gen_id }} {
    background: none;
    border: none;
    padding: {{ block.settings.tab_padding }}px 0;
    margin-right: {{ block.settings.tab_spacing }}px;
    font-size: {{ block.settings.tab_font_size }}px;
    color: {{ block.settings.inactive_tab_color }};
    cursor: pointer;
    position: relative;
    white-space: nowrap;
    transition: color 0.3s ease;
    font-weight: 400;
  }

  .ai-product-tabs__tab-{{ ai_gen_id }}:last-child {
    margin-right: 0;
  }

  .ai-product-tabs__tab-{{ ai_gen_id }}.active {
    color: {{ block.settings.active_tab_color }};
    font-weight: {{ block.settings.active_tab_weight }};
  }

  .ai-product-tabs__tab-{{ ai_gen_id }}.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: {{ block.settings.underline_thickness }}px;
    background-color: {{ block.settings.active_tab_color }};
  }

  .ai-product-tabs__content-{{ ai_gen_id }} {
    min-height: 200px;
  }

  .ai-product-tabs__panel-{{ ai_gen_id }} {
    display: none;
  }

  .ai-product-tabs__panel-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-product-tabs__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin }}px 0;
    font-family: "Poppins", sans-serif;
  }

  .ai-product-tabs__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_font_size }}px;
    line-height: {{ block.settings.content_line_height }};
    color: {{ block.settings.content_color }};
    margin: 0;
  }

  .ai-product-tabs__text-{{ ai_gen_id }} p {
    margin: 0 0 1em 0;
  }

  .ai-product-tabs__text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-product-tabs__empty-{{ ai_gen_id }} {
    color: {{ block.settings.content_color }};
    opacity: 0.6;
    font-style: italic;
    padding: 40px 0;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-product-tabs__tab-{{ ai_gen_id }} {
      font-size: {{ block.settings.tab_font_size | times: 0.9 }}px;
      margin-right: {{ block.settings.tab_spacing | times: 0.8 }}px;
    }

    .ai-product-tabs__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.9 }}px;
    }

    .ai-product-tabs__content-{{ ai_gen_id }} {
      min-height: 150px;
    }
  }
{% endstyle %}

<product-tabs-{{ ai_gen_id }}
  class="ai-product-tabs-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-tabs__nav-{{ ai_gen_id }}" role="tablist"><button
      class="ai-product-tabs__tab-{{ ai_gen_id }} active"
      role="tab"
      aria-selected="true"
      aria-controls="panel-description-{{ ai_gen_id }}"
      id="tab-description-{{ ai_gen_id }}"
      data-tab="description"
    >
      {{ block.settings.tab_1_label }}
    </button>
    <button
      class="ai-product-tabs__tab-{{ ai_gen_id }}"
      role="tab"
      aria-selected="false"
      aria-controls="panel-specifications-{{ ai_gen_id }}"
      id="tab-specifications-{{ ai_gen_id }}"
      data-tab="specifications"
    >
      {{ block.settings.tab_2_label }}
    </button>
    <button
      class="ai-product-tabs__tab-{{ ai_gen_id }}"
      role="tab"
      aria-selected="false"
      aria-controls="panel-shipping-{{ ai_gen_id }}"
      id="tab-shipping-{{ ai_gen_id }}"
      data-tab="shipping"
    >
      {{ block.settings.tab_3_label }}
    </button>
  </div>

  <div class="ai-product-tabs__content-{{ ai_gen_id }}">
    <div
      class="ai-product-tabs__panel-{{ ai_gen_id }} active"
      role="tabpanel"
      aria-labelledby="tab-description-{{ ai_gen_id }}"
      id="panel-description-{{ ai_gen_id }}"
      data-panel="description"
    >
      {% if block.settings.tab_1_title != blank %}
        <h3 class="ai-product-tabs__title-{{ ai_gen_id }}">{{ block.settings.tab_1_title }}</h3>
      {% endif %}
      {% if block.settings.tab_1_content != blank %}
        <div class="ai-product-tabs__text-{{ ai_gen_id }}">{{ block.settings.tab_1_content }}</div>
      {% else %}
        <div class="ai-product-tabs__empty-{{ ai_gen_id }}">Add content for the {{ block.settings.tab_1_label }} tab</div>
      {% endif %}
    </div>

    <div
      class="ai-product-tabs__panel-{{ ai_gen_id }}"
      role="tabpanel"
      aria-labelledby="tab-specifications-{{ ai_gen_id }}"
      id="panel-specifications-{{ ai_gen_id }}"
      data-panel="specifications"
    >
      {% if block.settings.tab_2_title != blank %}
        <h3 class="ai-product-tabs__title-{{ ai_gen_id }}">{{ block.settings.tab_2_title }}</h3>
      {% endif %}
      {% if block.settings.tab_2_content != blank %}
        <div class="ai-product-tabs__text-{{ ai_gen_id }}">{{ block.settings.tab_2_content }}</div>
      {% else %}
        <div class="ai-product-tabs__empty-{{ ai_gen_id }}">Add content for the {{ block.settings.tab_2_label }} tab</div>
      {% endif %}
    </div>

    <div
      class="ai-product-tabs__panel-{{ ai_gen_id }}"
      role="tabpanel"
      aria-labelledby="tab-shipping-{{ ai_gen_id }}"
      id="panel-shipping-{{ ai_gen_id }}"
      data-panel="shipping"
    >
      {% if block.settings.tab_3_title != blank %}
        <h3 class="ai-product-tabs__title-{{ ai_gen_id }}">{{ block.settings.tab_3_title }}</h3>
      {% endif %}
      {% if block.settings.tab_3_content != blank %}
        <div class="ai-product-tabs__text-{{ ai_gen_id }}">{{ block.settings.tab_3_content }}</div>
      {% else %}
        <div class="ai-product-tabs__empty-{{ ai_gen_id }}">Add content for the {{ block.settings.tab_3_label }} tab</div>
      {% endif %}
    </div>
  </div>
</product-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-product-tabs__tab-{{ ai_gen_id }}');
        this.panels = this.querySelectorAll('.ai-product-tabs__panel-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', (e) => {
            this.switchTab(e.target.dataset.tab);
          });

          tab.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              this.switchTab(e.target.dataset.tab);
            }
          });
        });
      }

      switchTab(targetTab) {
        this.tabs.forEach((tab) => {
          const isActive = tab.dataset.tab === targetTab;
          tab.classList.toggle('active', isActive);
          tab.setAttribute('aria-selected', isActive);
        });

        this.panels.forEach((panel) => {
          const isActive = panel.dataset.panel === targetTab;
          panel.classList.toggle('active', isActive);
        });
      }
    }

    customElements.define('product-tabs-{{ ai_gen_id }}', ProductTabs{{ ai_gen_id }});
  })();
</script>

