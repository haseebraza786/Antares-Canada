{% doc %}
  @prompt
    i want a courosel of collections, where only 3 are seen on desktop and 1 on mobile. also the nav icons should also be customizable. the should be in a square box together and the right bottom corner, the icons should be selectable,also when hovered the name of the collection should be shown in the center of the card with rectangular white background,  i want to give collections images from here only and also the the nav buttons should be below the corosel. i want the acess to change their position. also they should have a background, just remove the box shadow from the nav icons, just add a sqaure border of 0.6 px and #727272 color to both nav buttons

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 20px 0;
  }

  .ai-collection-carousel__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-collection-carousel__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.3s ease;gap: {{ block.settings.gap }}px;
  }

  .ai-collection-carousel__slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - {{ block.settings.gap | times: 2 }}px) / 3);
    position: relative;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.card_background_color }};
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .ai-collection-carousel__slide-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-collection-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;         {% comment %}  {{ block.settings.card_height }}px {% endcomment %}
    overflow: hidden;
  }

  .ai-collection-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-carousel__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-carousel__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-carousel__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.2);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-carousel__slide-{{ ai_gen_id }}:hover .ai-collection-carousel__overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-collection-carousel__title-{{ ai_gen_id }} {
    background-color: rgba(255, 255, 255, 0.95);
    color: {{ block.settings.title_color }};
    padding: 12px 20px;
    border-radius: 8px;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    text-align: center;
    margin: 0;
    backdrop-filter: blur(10px);
  }

  .ai-collection-carousel__navigation-{{ ai_gen_id }} {
    margin-top: 20px;
    display: flex;
    justify-content: {{ block.settings.nav_position }};
    align-items: center;
  }

  .ai-collection-carousel__nav-container-{{ ai_gen_id }} {
    background-color: {{ block.settings.nav_background_color }};
    border-radius: {{ block.settings.nav_border_radius }}px;
    padding: 8px;
    display: flex;
    gap: 8px;
  }

  .ai-collection-carousel__nav-btn-{{ ai_gen_id }} {
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border: 0.6px solid #727272;
    border-radius: {{ block.settings.nav_button_border_radius }}px;
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_icon_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-collection-carousel__nav-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
    color: {{ block.settings.nav_icon_hover_color }};transform: scale(1.1);
  }

  .ai-collection-carousel__nav-btn-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .ai-collection-carousel__nav-btn-{{ ai_gen_id }} svg {
    width: {{ block.settings.nav_icon_size }}px;
    height: {{ block.settings.nav_icon_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-collection-carousel__navigation-{{ ai_gen_id }} {
      justify-content: center;
    }
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }}
  class="ai-collection-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-carousel__container-{{ ai_gen_id }}">
    <div class="ai-collection-carousel__track-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% assign collection_key = 'collection_' | append: i %}
        {% assign image_key = 'collection_image_' | append: i %}
        {% assign collection = block.settings[collection_key] %}
        {% assign custom_image = block.settings[image_key] %}
        
        {% if collection != blank %}
          <div class="ai-collection-carousel__slide-{{ ai_gen_id }}" data-collection-url="{{ collection.url }}">
            <div class="ai-collection-carousel__image-wrapper-{{ ai_gen_id }}">
              {% if custom_image %}
                <img
                  src="{{ custom_image | image_url: width: 600 }}"
                  alt="{{ custom_image.alt | escape }}"
                  class="ai-collection-carousel__image-{{ ai_gen_id }}"
                  loading="lazy"width="600"
                  height="{{ block.settings.card_height }}"
                >
              {% elsif collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  class="ai-collection-carousel__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="{{ block.settings.card_height }}"
                >
              {% else %}
                <div class="ai-collection-carousel__image-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
              <div class="ai-collection-carousel__overlay-{{ ai_gen_id }}">
                <h3 class="ai-collection-carousel__title-{{ ai_gen_id }}">
                  {{ collection.title }}
                </h3>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-collection-carousel__navigation-{{ ai_gen_id }}">
      <div class="ai-collection-carousel__nav-container-{{ ai_gen_id }}"><button
          class="ai-collection-carousel__nav-btn-{{ ai_gen_id }} ai-collection-carousel__prev-{{ ai_gen_id }}"
          aria-label="Previous collections"
        >
          {% if block.settings.nav_icon_style == 'arrows' %}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          {% elsif block.settings.nav_icon_style == 'chevrons' %}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
            </svg>
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
            </svg>
          {% endif %}
        </button>
        
        <button
          class="ai-collection-carousel__nav-btn-{{ ai_gen_id }} ai-collection-carousel__next-{{ ai_gen_id }}"
          aria-label="Next collections"
        >
          {% if block.settings.nav_icon_style == 'arrows' %}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          {% elsif block.settings.nav_icon_style == 'chevrons' %}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
            </svg>
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          {% endif %}
        </button>
      </div>
    </div>
  </div>
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.slidesPerView = window.innerWidth <= 749 ? 1 : 3;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-collection-carousel__track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-collection-carousel__slide-{{ ai_gen_id }}');
        this.prevBtn = this.querySelector('.ai-collection-carousel__prev-{{ ai_gen_id }}');
        this.nextBtn = this.querySelector('.ai-collection-carousel__next-{{ ai_gen_id }}');

        this.totalSlides = this.slides.length;
        this.maxIndex = Math.max(0, this.totalSlides - this.slidesPerView);

        this.setupEventListeners();
        this.updateNavigation();
      }

      setupEventListeners() {
        this.prevBtn.addEventListener('click', () => this.goToPrevious());
        this.nextBtn.addEventListener('click', () => this.goToNext());

        this.slides.forEach(slide => {
          slide.addEventListener('click', () => {
            const url = slide.dataset.collectionUrl;
            if (url) {
              window.location.href = url;
            }
          });
        });

        window.addEventListener('resize', () => {
          const newSlidesPerView = window.innerWidth <= 749 ? 1 : 3;
          if (newSlidesPerView !== this.slidesPerView) {
            this.slidesPerView = newSlidesPerView;
            this.maxIndex = Math.max(0, this.totalSlides - this.slidesPerView);
            this.currentIndex = Math.min(this.currentIndex, this.maxIndex);
            this.updateCarousel();
            this.updateNavigation();
          }
        });
      }

      goToPrevious() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
          this.updateNavigation();
        }
      }

      goToNext() {
        if (this.currentIndex < this.maxIndex) {
          this.currentIndex++;
          this.updateCarousel();
          this.updateNavigation();
        }
      }

      updateCarousel() {
        const slideWidth = 100 / this.slidesPerView;
        const translateX = -(this.currentIndex * slideWidth);
        this.track.style.transform = `translateX(${translateX}%)`;
      }

      updateNavigation() {
        this.prevBtn.disabled = this.currentIndex === 0;
        this.nextBtn.disabled = this.currentIndex >= this.maxIndex;
      }
    }

    customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
  })();
</script>

