{% doc %}
  @prompt
    i want a courosel with star rating, review, customer name and their profession all alligned to left and one below the other. the nav arrows are in a boxes in the right bottom corner besides each other, overflow must be hidden, only one review can be seen at once, give button transperent  color but give it a border, also the stars are not visible now, the review must stay inside the slider, the customer name  size should also change

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-review-carousel-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    max-width: 100%;
  }

  .ai-review-carousel__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: auto;
    overflow: hidden;
    min-height: 200px;
  }

  .ai-review-carousel__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
    width: 100%;
    height: 100%;
  }

  .ai-review-carousel__slide-{{ ai_gen_id }} {
    min-width: 100%;
    max-width: 100%;
    flex-shrink: 0;
    padding: 20px;
    padding-bottom: 80px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .ai-review-carousel__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0px;
    text-align: left;
    max-width: 100%;
    height: 100%;
  }

  .ai-review-carousel__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 8px;
    flex-shrink: 0;
  }

  .ai-review-carousel__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    color: {{ block.settings.star_color }};
    flex-shrink: 0;
  }

  .ai-review-carousel__star--empty-{{ ai_gen_id }} {
    color: {{ block.settings.star_empty_color }};
  }

  .ai-review-carousel__review-{{ ai_gen_id }} {
    color: {{ block.settings.review_text_color }};
    font-size: 16px; /* match Figma */
    font-weight: 300; /* Light */
    font-family: 'Poppins', sans-serif; /* add Poppins */
    
   
    margin: 0 0 10px 0; /* paragraph spacing = 10px */
    text-align: justify; /* justified text */

    max-width: 100%;
    flex-grow: 1;
  }

  .ai-review-carousel__customer-{{ ai_gen_id }} {
    color: {{ block.settings.customer_text_color }};
    font-size: 16px !important; 
    font-weight: 500 !important;
    font-family: 'Poppins', sans-serif !important; 
    margin:0 !important;
    letter-spacing: 0;
    text-align: justify;
    word-wrap: break-word;
    overflow-wrap: break-word;
    max-width: 100%;
    flex-shrink: 0;
  }

  .ai-review-carousel__profession-{{ ai_gen_id }} {
     color: {{ block.settings.profession_text_color }};
    font-size: 12px !important; /* Figma */
    font-weight: 400 !important; /* Regular */
    font-family: 'Poppins', sans-serif !important;
    text-align: justify;
    word-wrap: break-word;
    overflow-wrap: break-word;
    max-width: 100%;
    flex-shrink: 0;
    margin: 0 !important; 
  }

  .ai-review-carousel__navigation-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    right: 20px;
    display: flex;
    gap: 8px;
    z-index: 10;
  }

  .ai-review-carousel__nav-button-{{ ai_gen_id }} {
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    background-color: transparent;
    border: {{ block.settings.nav_button_border_width }}px solid {{ block.settings.nav_button_border_color }};
    border-radius: {{ block.settings.nav_button_radius }}px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    color: {{ block.settings.nav_icon_color }};
    flex-shrink: 0;
  }

  .ai-review-carousel__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
    border-color: {{ block.settings.nav_button_hover_border_color }};
  }

  .ai-review-carousel__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-review-carousel__nav-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-review-carousel-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }

    .ai-review-carousel__slide-{{ ai_gen_id }} {
      padding: 15px;
      padding-bottom: 70px;
    }

    .ai-review-carousel__navigation-{{ ai_gen_id }} {
      bottom: 15px;
      right: 15px;
    }

    .ai-review-carousel__nav-button-{{ ai_gen_id }} {
      width: {{ block.settings.nav_button_size | times: 0.8 }}px;
      height: {{ block.settings.nav_button_size | times: 0.8 }}px;
    }

    .ai-review-carousel__customer-{{ ai_gen_id }} {
      font-size: {{ block.settings.customer_font_size | times: 0.9 }}px;
    }

    .ai-review-carousel__review-{{ ai_gen_id }} {
      font-size: {{ block.settings.review_font_size | times: 0.9 }}px;
    }

    .ai-review-carousel__profession-{{ ai_gen_id }} {
      font-size: {{ block.settings.profession_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<review-carousel-{{ ai_gen_id }}
  class="ai-review-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-review-carousel__container-{{ ai_gen_id }}">
    <div class="ai-review-carousel__track-{{ ai_gen_id }}" data-track>
      {% for i in (1..5) %}
        {% liquid
          assign rating_key = 'review_' | append: i | append: '_rating'
          assign review_key = 'review_' | append: i | append: '_text'
          assign customer_key = 'review_' | append: i | append: '_customer'
          assign profession_key = 'review_' | append: i | append: '_profession'

          assign rating = block.settings[rating_key]
          assign review_text = block.settings[review_key]
          assign customer_name = block.settings[customer_key]
          assign profession = block.settings[profession_key]
        %}

        {% if review_text != blank and customer_name != blank %}
          <div class="ai-review-carousel__slide-{{ ai_gen_id }}">
            <div class="ai-review-carousel__content-{{ ai_gen_id }}">
              <div class="ai-review-carousel__stars-{{ ai_gen_id }}">
                {% for star in (1..5) %}<svg
                    class="ai-review-carousel__star-{{ ai_gen_id }} {% if star > rating %}ai-review-carousel__star--empty-{{ ai_gen_id }}{% endif %}"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {% endfor %}
              </div>

              <p class="ai-review-carousel__review-{{ ai_gen_id }}">{{ review_text }}</p>

              <h3 class="ai-review-carousel__customer-{{ ai_gen_id }}">{{ customer_name }}</h3>

              {% if profession != blank %}
                <p class="ai-review-carousel__profession-{{ ai_gen_id }}">{{ profession }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-review-carousel__navigation-{{ ai_gen_id }}">
      <button
        class="ai-review-carousel__nav-button-{{ ai_gen_id }}"
        data-prev
        aria-label="Previous review"
      >
        <svg
          class="ai-review-carousel__nav-icon-{{ ai_gen_id }}"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15,18 9,12 15,6"></polyline>
        </svg>
      </button>
      <button
        class="ai-review-carousel__nav-button-{{ ai_gen_id }}"
        data-next
        aria-label="Next review"
      >
        <svg
          class="ai-review-carousel__nav-icon-{{ ai_gen_id }}"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9,18 15,12 9,6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</review-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.totalSlides = 0;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.slides = this.track.querySelectorAll('.ai-review-carousel__slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');

        this.totalSlides = this.slides.length;

        if (this.totalSlides <= 1) {
          this.querySelector('.ai-review-carousel__navigation-{{ ai_gen_id }}').style.display = 'none';
          return;
        }

        this.setupEventListeners();
        this.updateButtons();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.goToPrevSlide());
        this.nextButton.addEventListener('click', () => this.goToNextSlide());
      }

      goToPrevSlide() {
        if (this.currentSlide > 0) {
          this.currentSlide--;
          this.updateCarousel();
        }
      }

      goToNextSlide() {
        if (this.currentSlide < this.totalSlides - 1) {
          this.currentSlide++;
          this.updateCarousel();
        }
      }

      updateCarousel() {
        const translateX = -this.currentSlide * 100;
        this.track.style.transform = `translateX(${translateX}%)`;
        this.updateButtons();
      }

      updateButtons() {
        this.prevButton.disabled = this.currentSlide === 0;
        this.nextButton.disabled = this.currentSlide === this.totalSlides - 1;
      }
    }

    customElements.define('review-carousel-{{ ai_gen_id }}', ReviewCarousel{{ ai_gen_id }});
  })();
</script>

