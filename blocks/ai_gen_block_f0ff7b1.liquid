{% doc %}
  @prompt
    i want a custom section with 2 groups horizontal in desktop and vertical in mobile. the left group will have a image , the right group will have a heading and a subheading, (h2 and p) followed by a button vertically. the two groups will overlap each other in such a way that the right group will be on top if the left group. i also want the acess to change the position of both groups by myself

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-overlap-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: 400px;
    
  }

  .ai-overlap-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: center;
    max-width: 1170px;
  }

  .ai-overlap-image-group-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    grid-column: 1;
    grid-row: 1;
    transform: translate({{ block.settings.image_position_x }}%, {{ block.settings.image_position_y }}%);
  }

  .ai-overlap-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-overlap-image-{{ ai_gen_id }} {
    width: 600px;
    height: 570px;
    display: block;
    max-width:none;
  }

  .ai-overlap-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 300px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-overlap-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-overlap-content-group-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    grid-column: 2;
    grid-row: 1;
    background-color: #ffffff;
    border-radius: 0px;
    transform: translate(-15%, -6%);
    max-width: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    padding: 60px 76px;
    width: 670px;

}
  }

  .ai-overlap-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .ai-overlap-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 24px 0;
    line-height: 1.4;
    text-align: justify;
  }

  .ai-overlap-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 500;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-overlap-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-overlap-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      gap: 20px;
    }

    .ai-overlap-image-group-{{ ai_gen_id }} {
      grid-column: 1;
      grid-row: 1;transform: none;
      z-index: 1;
    }

    .ai-overlap-content-group-{{ ai_gen_id }} {
      grid-column: 1;
      grid-row: 2;
      transform: none;
      z-index: 1;max-width: 100%;
    }

    .ai-overlap-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-overlap-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-overlap-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-overlap-container-{{ ai_gen_id }}">
    <div class="ai-overlap-image-group-{{ ai_gen_id }}">
      <div class="ai-overlap-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            class="ai-overlap-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {% else %}
          <div class="ai-overlap-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-overlap-content-group-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-overlap-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <p class="ai-overlap-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-overlap-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Overlap Content Section",
  "settings": [
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Image max width",
      "default": 500
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Image Position"
    },
    {
      "type": "range",
      "id": "image_position_x",
      "min": -50,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Horizontal position",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_position_y",
      "min": -50,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Vertical position",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Amazing Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "This is your subheading text that provides more details about your content."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Content Position"
    },
    {
      "type": "range",
      "id": "content_position_x",
      "min": -50,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Horizontal position",
      "default": -25
    },
    {
      "type": "range",
      "id": "content_position_y",
      "min": -50,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Vertical position",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content Style"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "label": "Content max width",
      "default": 400
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Content padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "content_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Content border radius",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "content_shadow",
      "label": "Content shadow",
      "default": true
    },
    {
      "type": "color",
      "id": "content_background_color",
      "label": "Content background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subheading size",
      "default": 16
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Button Style"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 6
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_background_color",
      "label": "Button hover background color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Overlap Content Section"
    }
  ]
}
{% endschema %}