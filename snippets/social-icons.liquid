<div class="header__social-icons desktop-only">
  <a href="https://facebook.com" class="social-icon" aria-label="Facebook">
    {{ 'icon-facebook.svg' | inline_asset_content }}
  </a>
  <a href="https://instagram.com" class="social-icon" aria-label="Instagram">
    {{ 'icon-instagram.svg' | inline_asset_content }}
  </a>
  <a href="https://x.com" class="social-icon" aria-label="X (Twitter)">
    {{ 'icon-x.svg' | inline_asset_content }}
  </a>
  <a href="https://youtube.com" class="social-icon" aria-label="YouTube">
    {{ 'icon-youtube.svg' | inline_asset_content }}
  </a>
</div>


{% stylesheet %}
.header__social-icons {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.header__social-icons .social-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 15.88px;
  height: 12.15px;
  color: #FFFFFF;
}

.header__social-icons .social-icon svg {
  width: 100%;
  height: 100%;
  transition: opacity 0.3s ease;
}

.header__social-icons .social-icon:hover svg {
  opacity: 0.7;
}

/* Hide on mobile */
@media screen and (max-width: 749px) {
  .desktop-only {
    display: none !important;
  }
}
{% endstylesheet %}