          "blocks": {
            "custom_liquid_4nVhGE": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<div class=\"home-blog-landing-wrapper\">\n  <div class=\"blog-cards\">\n    {% assign blog_handle = 'blog' %}\n    {% assign blog_articles = blogs[blog_handle].articles | sort: 'published_at' | reverse | slice: 0, 3 %}\n\n    {% for article in blog_articles %}\n    <div class=\"blog-card\">\n      <div class=\"blog-card-image\">\n        <a href=\"{{ article.url }}\">\n          <img src=\"{{ article.image | img_url: '600x400' }}\" alt=\"{{ article.title }}\">\n          <time class=\"blog-date-overlay\"><p>{{ article.published_at | date: \"%b %d, %Y\" }}</p></time>\n        </a>\n      </div>\n\n      <div class=\"blog-card-content\">\n        <h5 class=\"blog-heading\">{{ article.title | truncate: 60 }}</h5>\n\n        <p class=\"blog-excerpt\">\n            {{ article.content | strip_html | truncate: 50 }}\n        </p>\n        \n        <p><a class=\"read-more-btn\" href=\"{{ article.url }}\">Read More</a></p>\n      </div>\n    </div>\n    {% endfor %}\n  </div>\n\n  <div class=\"slider-dots\"></div>\n    <a href=\"{{ article.url }}\" class=\"read-all-blogs-btn\">\n        Read All Blogs\n    </a>\n</div>\n<style>\n    .home-blog-landing-wrapper {\n        padding: 40px 20px;\n        text-align: center;\n        position: relative;\n    }\n\n    .home-blog-title {\n        font-size: 36px;\n        font-weight: 700;\n        margin-bottom: 40px;\n        margin-top: 90px;\n    }\n\n\n.blog-card{\n  background:#fff;\n  border-radius:12px;\n  overflow:hidden;\n  box-shadow:0 10px 24px rgba(0,0,0,.08);\n  transition:transform .25s ease, box-shadow .25s ease;\n  width: 370px;\n  height:330px;\n  border-radius: 0;\n}\n.blog-card:hover{\n  transform:translateY(-6px);\n  box-shadow:0 16px 32px rgba(0,0,0,.12);\n}\n\n/* Image crops like the reference + overlay badge */\n.blog-card-image{\n  position:relative;\n  height:185px;               /* consistent image height */\n  overflow:hidden;\n}\n.blog-card-image img{\n  width:100%;\n  height:100%;\n  object-fit:cover;\n  display:block;\n}\n/* light-blue \"Article\" pill (as in screenshot) */\n.blog-card-image::after{\n  content:\"Article\";\n  position:absolute;\n  top:14px;\n  left:14px;\n  padding:6px 10px;\n  font-size:12px;\n  line-height:1;\n  color:#0c0c0c;\n  background:#cfeaff;         /* soft blue */\n  border-radius:6px;\n  font-weight:600;\n  letter-spacing:.1px;\n}\n\n/* Card content */\n.blog-card-content{\n  padding:22px 24px 24px;\n  text-align:left;\n}\n.blog-date{\n  font-size:12px;\n  color:#6b7280;              /* muted gray */\n  margin:0 0 8px;\n}\n.blog-heading{\n  font-size:18px;\n  font-weight:700;\n  color:#111827;\n  margin:0 0 10px;\n}\n\n/* \"Read More →\" as a text link, not a filled button */\n.read-more-btn{\n  background:transparent !important;\n  border:0 !important;\n  color:#111827;\n  padding:0;\n  font-size:14px;\n  line-height:1.6;\n  font-weight:600;\n  border-bottom:1px solid transparent;\n  display:inline-flex;\n  align-items:center;\n  gap:8px;\n  text-decoration:none;\n  transition:gap .2s ease, border-color .2s ease;\n}\n.read-more-btn::after{ content:\"\\2192\"; } /* → */\n.read-more-btn:hover{\n  border-bottom-color:#111827;\n  gap:10px;                   /* subtle arrow nudge */\n}\n\n/* Grid spacing like reference */\n.blog-cards{\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  gap:28px;\n}\n\n/* \"Read All Blogs\" CTA — solid black rounded button centered */\n.view-all-blogs{\n  margin:34px 0 16px;\n  display:flex;\n  justify-content:center;\n}\n.view-all-blogs a{\n  background:#111 !important;\n  color:#fff;\n  border:0 !important;\n  padding:12px 26px;\n  font-size:14px;\n  font-weight:700;\n  border-radius:8px;\n  text-decoration:none;\n  transition:transform .2s ease, box-shadow .2s ease, opacity .2s ease;\n}\n.view-all-blogs a:hover{\n  transform:translateY(-2px);\n  box-shadow:0 8px 16px rgba(0,0,0,.18);\n  opacity:.95;\n}\n\n/* Date chip over image */\n.blog-card-image { position:relative; }\n.blog-date-overlay{\n  position:absolute;\n  left:14px;\n  bottom:0px;\n  padding:6px 10px;\n  font-size:12px;\n  line-height:1;\n  color:#fff;\n  border-radius:6px;\n  font-weight:600;\n  letter-spacing:.1px;\n  pointer-events:none; /* don’t block the link */\n}\n\n.read-all-blogs-btn {\n  display: inline-flex;               /* allows text + optional icon alignment */\n  align-items: center;\n  justify-content: center;\n  gap: 10px;                           /* spacing if you add an arrow or icon */\n  background: #0B0D0F;                 /* from Figma */\n  color: #fff;\n  font-size: 16px;\n  font-weight: 500;\n  text-decoration: none;\n  padding: 20px 35px;                  /* matches Figma padding */\n  height: 50px;                        /* fixed height */\n  min-width: 179px;                    /* Figma width */\n  border-radius: 0px;                  /* small rounded corners */\n  transition: transform .2s ease, opacity .2s ease;\n  margin-top: 50px;\n}\n\n.read-all-blogs-btn:hover {\n  transform: translateY(-2px);\n  opacity: 0.9;\n}\n\n/* --- Mobile slider tweaks to preserve look --- */\n@media only screen and (max-width: 767px){\n  .blog-card{ min-width:88%; margin:0 10px; }\n  .blog-card-image{ height:200px; }\n  .slider-dots{ display:flex; justify-content:center; margin-top:14px; padding-bottom:8px; }\n  .slider-dots span{\n    width:8px; height:8px; border-radius:999px; background:#d1d5db;\n    margin:0 4px; transition:all .25s ease;\n  }\n  .slider-dots span.active{ background:#111; width:18px; }\n}\n\n/* Hide slider dots on desktop */\n@media only screen and (min-width: 768px){\n  .slider-dots{ display:none; }\n}\n\n</style>\n\n<script>\n    document.addEventListener('DOMContentLoaded', function () {\n        if (window.innerWidth <= 767) {\n            const cards = document.querySelector('.blog-cards');\n            const dots = document.querySelector('.slider-dots');\n            const cardCount = document.querySelectorAll('.blog-card').length;\n\n            // Create dots\n            for (let i = 0; i < cardCount; i++) {\n                const dot = document.createElement('span');\n                dot.dataset.index = i;\n                if (i === 0) dot.classList.add('active');\n                dot.addEventListener('click', function () {\n                    scrollToCard(i);\n                    updateDots(i);\n                });\n                dots.appendChild(dot);\n            }\n\n            // Scroll to card function\n            function scrollToCard(index) {\n                const card = document.querySelectorAll('.blog-card')[index];\n                cards.scrollTo({\n                    left: card.offsetLeft,\n                    behavior: 'smooth'\n                });\n            }\n\n            // Update dots\n            function updateDots(activeIndex) {\n                document.querySelectorAll('.slider-dots span').forEach((dot, index) => {\n                    dot.classList.toggle('active', index === activeIndex);\n                });\n            }\n\n            // Handle scroll events\n            let isScrolling = false;\n            cards.addEventListener('scroll', function () {\n                if (!isScrolling) {\n                    window.requestAnimationFrame(function () {\n                        const cardWidth = document.querySelector('.blog-card').offsetWidth;\n                        const scrollPosition = cards.scrollLeft;\n                        const activeIndex = Math.round(scrollPosition / cardWidth);\n                        updateDots(activeIndex);\n                        isScrolling = false;\n                    });\n                    isScrolling = true;\n                }\n            }, { passive: true });\n        }\n    });\n</script>"
              },
              "blocks": {}
            }
          },
