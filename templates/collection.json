            "text_bXdBwY": {
              "type": "text",
              "name": "t:names.text",
              "settings": {
                "text": "<p>Choose Antares Athletics for your ultimate safety and success in combat sports. Explore our essential collection. You will find comprehensive Premium no-gi and protective gear designed for safety and performance. Here, discover vital No-gi and protective gear engineered to elevate your training confidence. We feature top-tier Boxing equipment crafted for all combat disciplines. Our range includes durable custom shinguards and crucial Protective headgear.</p>",
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
